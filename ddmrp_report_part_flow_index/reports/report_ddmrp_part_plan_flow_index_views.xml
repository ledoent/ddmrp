<odoo>
    <record id="view_stock_buffer_flow_index_list" model="ir.ui.view">
        <field name="name">stock.buffer.flow.index.list</field>
        <field name="model">stock.buffer</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Parts Flow Index" create="false" edit="false">
                <field name="name" />
                <field name="product_id" />
                <field name="location_id" />
                <field name="green_zone_qty" />
                <field name="adu" />
                <field name="order_frequency" />
                <field name="order_frequency_group" optional="hide" />
                <field name="flow_index_group_id" widget="badge" decoration-info="1" />
                <field name="actual_order_count" optional="show" />
                <field name="actual_order_frequency" optional="show" />
                <field name="actual_order_frequency_group" optional="hide" />
                <field
                    name="actual_flow_index_group_id"
                    widget="badge"
                    decoration-info="1"
                    optional="show"
                />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record id="view_stock_buffer_flow_index_pivot" model="ir.ui.view">
        <field name="name">stock.buffer.flow.index.pivot</field>
        <field name="model">stock.buffer</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <pivot string="Parts Flow Index">
                <field name="flow_index_group_id" type="row" />
                <field name="order_frequency_group" type="measure" />
                <field name="actual_order_frequency_group" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_stock_buffer_flow_index_graph" model="ir.ui.view">
        <field name="name">stock.buffer.flow.index.graph</field>
        <field name="model">stock.buffer</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <graph string="Parts Flow Index" type="bar">
                <field name="flow_index_group_id" />
            </graph>
        </field>
    </record>

    <record id="view_stock_buffer_flow_index_filter" model="ir.ui.view">
        <field name="name">stock.buffer.flow.index.search</field>
        <field name="model">stock.buffer</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Parts Flow Index">
                <field name="name" />
                <field name="product_id" />
                <field name="location_id" />
                <field name="flow_index_group_id" />
                <field name="actual_flow_index_group_id" />
                <group>
                    <filter
                        name="group_flow_index"
                        string="Flow Index Group"
                        context="{'group_by': 'flow_index_group_id'}"
                    />
                    <filter
                        name="group_actual_flow_index"
                        string="Actual Flow Index Group"
                        context="{'group_by': 'actual_flow_index_group_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Parts PLAN Flow Index: classification from planned buffer sizing -->
    <record
        id="action_report_part_plan_flow_index_template"
        model="ir.actions.act_window"
    >
        <field name="name">Parts Plan Flow Index</field>
        <field name="res_model">stock.buffer</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_stock_buffer_flow_index_filter" />
        <field name="context">{'search_default_group_flow_index': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'sequence': 1, 'view_mode': 'list', 'view_id': ref('view_stock_buffer_flow_index_list')}),
                   (0, 0, {'sequence': 2, 'view_mode': 'pivot', 'view_id': ref('view_stock_buffer_flow_index_pivot')}),
                   (0, 0, {'sequence': 3, 'view_mode': 'graph', 'view_id': ref('view_stock_buffer_flow_index_graph')})]"
        />
    </record>

    <menuitem
        id="menu_report_part_plan_flow_index"
        action="action_report_part_plan_flow_index_template"
        name="Parts Plan Flow Index"
        parent="stock.menu_warehouse_report"
        groups="stock.group_stock_manager"
    />

    <!-- Parts ACTUAL Flow Index: classification from real replenishment history -->
    <record
        id="action_report_part_actual_flow_index_template"
        model="ir.actions.act_window"
    >
        <field name="name">Parts Actual Flow Index</field>
        <field name="res_model">stock.buffer</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_stock_buffer_flow_index_filter" />
        <field name="context">{'search_default_group_actual_flow_index': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'sequence': 1, 'view_mode': 'list', 'view_id': ref('view_stock_buffer_flow_index_list')}),
                   (0, 0, {'sequence': 2, 'view_mode': 'pivot', 'view_id': ref('view_stock_buffer_flow_index_pivot')}),
                   (0, 0, {'sequence': 3, 'view_mode': 'graph', 'view_id': ref('view_stock_buffer_flow_index_graph')})]"
        />
    </record>

    <menuitem
        id="menu_report_part_actual_flow_index"
        action="action_report_part_actual_flow_index_template"
        name="Parts Actual Flow Index"
        parent="stock.menu_warehouse_report"
        groups="stock.group_stock_manager"
    />
</odoo>
