<odoo>
    <record id="stock_buffer_view_form_inherited" model="ir.ui.view">
        <field name="name">stock.buffer.form - Part Flow Index</field>
        <field name="model">stock.buffer</field>
        <field name="inherit_id" ref="ddmrp.stock_buffer_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="flow_index" string="Flow Index">
                    <group>
                        <group name="flow_index_plan" string="Planned">
                            <field name="order_frequency" />
                            <field name="order_frequency_group" />
                            <field name="flow_index_group_id" widget="badge" />
                        </group>
                        <group name="flow_index_actual" string="Actual">
                            <field name="actual_order_frequency" />
                            <field name="actual_order_count" />
                            <field name="actual_flow_index_group_id" widget="badge" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
