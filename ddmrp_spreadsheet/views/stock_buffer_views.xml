<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════════
         Menu item: Spreadsheet Dashboards under DDMRP → Reporting
         ════════════════════════════════════════════════════════════════════ -->

    <record id="action_ddmrp_spreadsheets" model="ir.actions.act_window">
        <field name="name">DDMRP Spreadsheets</field>
        <field name="res_model">spreadsheet.spreadsheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a DDMRP spreadsheet dashboard
            </p>
            <p>
                Use spreadsheet dashboards to monitor buffer status,
                zone sizing, and priority levels with dynamic pivot
                tables connected to your DDMRP data.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_ddmrp_spreadsheets"
        name="Spreadsheets"
        parent="stock.menu_warehouse_report"
        action="action_ddmrp_spreadsheets"
        sequence="90"
    />
</odoo>
